<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Compact bottle widget (always visible) -->
    <LinearLayout
        android:id="@+id/compact_widget"
        android:layout_width="68dp"
        android:layout_height="126dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_overlay_compact"
        android:padding="4dp"
        android:elevation="8dp">

        <!-- Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DATA"
            android:textSize="7sp"
            android:textColor="#88ffffff"
            android:letterSpacing="0.15"
            android:layout_marginBottom="2dp"/>

        <!-- Custom bottle view -->
        <com.databottle.BottleView
            android:id="@+id/bottle_view"
            android:layout_width="38dp"
            android:layout_height="70dp"/>

        <!-- Percent remaining -->
        <TextView
            android:id="@+id/tv_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#00ff88"
            android:layout_marginTop="3dp"/>

        <!-- Used / total -->
        <TextView
            android:id="@+id/tv_gb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:textSize="7sp"
            android:textColor="#66ffffff"
            android:gravity="center"
            android:layout_marginTop="1dp"/>

    </LinearLayout>

    <!-- Expanded detail panel (shown on tap) -->
    <LinearLayout
        android:id="@+id/expanded_panel"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_expanded_panel"
        android:padding="12dp"
        android:layout_marginTop="130dp"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📶 Mobile Data"
            android:textColor="#00ff88"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tv_used_exp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Used: —"
            android:textColor="#ccffffff"
            android:textSize="12sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_remaining_exp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Left: —"
            android:textColor="#ccffffff"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/btn_close_expand"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="✕ Close"
            android:textColor="#88ffffff"
            android:textSize="11sp"
            android:gravity="center"
            android:background="@drawable/bg_close_btn"
            android:padding="4dp"/>

    </LinearLayout>

</FrameLayout>
